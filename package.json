{
  "name": "honobox",
  "scripts": {
    "📦": "──────────────── Workspace ────────────────",
    "dev": "bun run --hot src/server.ts",
    "dev:cfw": "wrangler dev",
    "deploy:cfw": "wrangler deploy --minify",
    "typegen:cfw": "wrangler types --env-interface CloudflareBindings",
    "🗄": "──────────────── Database ────────────────",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:update": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "bun ./src/drizzle/seed.ts",
    "db:push": "drizzle-kit push",
    "db:start-studio": "drizzle-kit studio",
    "🧹": "──────────────── Hygiene ────────────────",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.17",
    "@hono/node-server": "^1.19.4",
    "@libsql/client": "^0.15.15",
    "ai": "^5.0.54",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "latest",
    "wrangler": "^4.4.0",
    "drizzle-kit": "^0.31.4"
  }
}
